{
  "name": "zendian",
  "version": "3.2.04",
  "description": "A personal knowledge and project workspace for Obsidian.",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:js": "node esbuild.config.mjs production",
    "build:css": "node scripts/build-css.mjs",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "check:settings": "node scripts/check-settings-contract.mjs",
    "check:safety": "node scripts/check-safety-contract.mjs",
    "check:css": "node scripts/check-css-contract.mjs",
    "check:typewriter": "node scripts/check-typewriter-contract.mjs",
    "check": "npm run typecheck && npm run check:settings && npm run check:safety && npm run check:css && npm run check:typewriter"
  },
  "keywords": [
    "obsidian",
    "productivity",
    "project-management",
    "tasks",
    "knowledge-management"
  ],
  "author": "Junkey",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "chroma-js": "^2.4.0"
  }
}
